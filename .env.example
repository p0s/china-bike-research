# Optional local overrides. Cloudflare production uses scripts/build-cloudflare.mjs.
# Do not commit a populated .env file.
PUBLIC_REPOSITORY_URL=
PUBLIC_SITE_URL=
PUBLIC_BASE_PATH=
PORT=4173

# Wrangler reads this only from your local environment. Leave the example blank.
CLOUDFLARE_ACCOUNT_ID=

# Public HTML verification token only (not an account credential). Optional.
GOOGLE_SITE_VERIFICATION=

# Server-only Worker bindings; never put these in browser code or a populated .env committed to Git.
ANALYTICS_INGEST_URL=https://stats.p0s.eu/ingest/v1
ANALYTICS_INGEST_TOKEN=
