{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/image.schema.json",
  "title": "Product image record",
  "type": "object",
  "required": [
    "id",
    "role",
    "subject_accuracy",
    "media_type",
    "hosting",
    "source_id",
    "rights",
    "credit",
    "alt",
    "reviewed_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "platform_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "variant_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "role": {
      "const": "primary"
    },
    "buyer_visibility": {
      "enum": ["show", "omit"]
    },
    "subject_accuracy": {
      "enum": [
        "exact-variant",
        "exact-platform",
        "same-platform",
        "same-model-different-color",
        "same-model-different-market-build",
        "illustrative"
      ]
    },
    "media_type": {
      "enum": [
        "official-product-photo",
        "retailer-product-photo",
        "community-post-photo",
        "project-placeholder"
      ]
    },
    "hosting": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "remote_url"
          ],
          "properties": {
            "mode": {
              "const": "remote"
            },
            "remote_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "variants": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "purpose",
                  "url",
                  "width",
                  "height",
                  "bytes",
                  "sha256",
                  "format"
                ],
                "properties": {
                  "purpose": {
                    "enum": ["card", "detail"]
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2400
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 88000
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "format": {
                    "const": "image/webp"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "local_path"
          ],
          "properties": {
            "mode": {
              "const": "local"
            },
            "local_path": {
              "type": "string",
              "pattern": "^/assets/images/"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "rights": {
      "type": "object",
      "required": [
        "status",
        "copyright_holder",
        "usage_note"
      ],
      "properties": {
        "status": {
          "enum": [
            "project-owned",
            "contributor-owned",
            "permission-granted",
            "brand-media-license",
            "cc-licensed",
            "public-domain",
            "official-page-embed",
            "retailer-page-embed",
            "public-post-embed",
            "public-post-quotation"
          ]
        },
        "copyright_holder": {
          "type": "string",
          "minLength": 1
        },
        "usage_note": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_date": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": true
    },
    "credit": {
      "type": "string",
      "minLength": 3
    },
    "alt": {
      "type": "string",
      "minLength": 10
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "display_note": {
      "type": "string",
      "minLength": 10
    },
    "editorial_quotation": {
      "type": "object",
      "required": [
        "purpose",
        "scope",
        "source_link_required",
        "no_license_asserted",
        "removal_route"
      ],
      "properties": {
        "purpose": {
          "const": "editorial-identification-and-commentary"
        },
        "scope": {
          "const": "one-compressed-public-post-photo"
        },
        "source_link_required": {
          "const": true
        },
        "no_license_asserted": {
          "const": true
        },
        "removal_route": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "additionalProperties": false
    },
    "privacy_review": {
      "type": "object",
      "required": [
        "reviewed_at",
        "embedded_metadata",
        "faces",
        "vehicle_registration",
        "account_identifiers",
        "location_identifiers"
      ],
      "properties": {
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "embedded_metadata": {
          "const": "stripped"
        },
        "faces": {
          "const": "none-visible"
        },
        "vehicle_registration": {
          "const": "none-visible"
        },
        "account_identifiers": {
          "const": "none-visible"
        },
        "location_identifiers": {
          "const": "none-visible"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "required": ["platform_id"],
      "not": { "required": ["candidate_id"] }
    },
    {
      "required": ["candidate_id"],
      "not": { "required": ["platform_id"] }
    }
  ],
  "additionalProperties": false
}
