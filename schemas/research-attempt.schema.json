{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://china-bikes.p0s.eu/schemas/research-attempt.schema.json",
  "title": "Atomic research attempt ledger record",
  "type": "object",
  "required": ["id", "target", "field", "priority", "searched_at", "required_channels", "channels", "status", "notes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "target": {
      "type": "object",
      "required": ["record_type", "record_id"],
      "properties": {
        "record_type": { "enum": ["candidate", "platform", "variant"] },
        "record_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      },
      "additionalProperties": false
    },
    "field": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "priority": { "enum": ["high", "medium", "low"] },
    "searched_at": { "type": "string", "format": "date" },
    "required_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["public-post", "web"] }
    },
    "channels": {
      "type": "object",
      "properties": {
        "public-post": { "$ref": "#/$defs/channel" },
        "web": { "$ref": "#/$defs/channel" }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["found", "temporarily-exhausted", "blocked", "conflicted", "open"] },
    "accepted_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "retry_after": { "type": ["string", "null"], "format": "date" },
    "notes": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["status", "attempts"],
      "properties": {
        "status": { "enum": ["found", "temporarily-exhausted", "blocked", "conflicted", "not-run"] },
        "blocker": { "type": "string" },
        "conflict": { "type": "string" },
        "attempts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["attempt", "query", "route", "outcome", "accessed_at", "note"],
            "properties": {
              "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
              "query": { "type": "string", "minLength": 1 },
              "route": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["found", "no-result", "rejected", "blocked", "conflict"] },
              "result_url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "accessed_at": { "type": "string", "format": "date" },
              "note": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
