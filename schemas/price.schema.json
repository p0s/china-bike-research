{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/price.schema.json",
  "title": "Price",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "variant_id",
    "observed_at",
    "price_type",
    "currency",
    "source_ids"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "variant_id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "price_type": {
      "type": "string"
    },
    "currency": {
      "enum": ["CNY", "EUR", "GBP", "USD", "CAD", "MXN"]
    },
    "amount_cny": {
      "type": "number"
    },
    "low_cny": {
      "type": "number"
    },
    "high_cny": {
      "type": "number"
    },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "market_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["eu", "gb", "us", "ca", "mx"] } },
    "package_kind": { "enum": ["frameset", "complete-bike"] },
    "package_label": { "type": "string", "minLength": 1 },
    "country_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "supersedes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "delivery": {
      "type": "object",
      "required": ["status", "scope", "basis", "source_ids"],
      "properties": {
        "status": { "enum": ["confirmed", "estimated", "partial"] },
        "scope": { "enum": ["standard-addresses", "contiguous-us"] },
        "total_low": { "type": "number", "minimum": 0 },
        "total_high": { "type": "number", "minimum": 0 },
        "shipping_included": { "type": "boolean" },
        "taxes_duties_included": { "type": "boolean" },
        "all_required_charges_included": { "type": "boolean" },
        "country_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
        "excluded_country_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
        "basis": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "if": { "properties": { "status": { "enum": ["confirmed", "estimated"] } } },
      "then": { "required": ["total_low", "total_high", "shipping_included", "taxes_duties_included"], "properties": { "shipping_included": { "const": true }, "taxes_duties_included": { "const": true } } }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "if": { "required": ["market_ids"] },
  "then": {
    "required": ["amount", "package_kind", "package_label", "conditions", "channel", "status"],
    "properties": { "price_type": { "const": "regional-listed-offer" }, "currency": { "enum": ["EUR", "GBP", "USD", "CAD", "MXN"] }, "status": { "const": "listed" } },
    "not": { "anyOf": [{ "required": ["amount_cny"] }, { "required": ["low_cny"] }, { "required": ["high_cny"] }] }
  },
  "else": { "properties": { "currency": { "const": "CNY" } } }
}
