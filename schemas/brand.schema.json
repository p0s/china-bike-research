{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/brand.schema.json",
  "title": "Brand",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "manufacturing",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "name_zh": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "manufacturing": {
      "type": "object"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
