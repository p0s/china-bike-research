{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/video.schema.json",
  "title": "Curated model video",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "provider",
    "title",
    "channel_name",
    "url",
    "language",
    "accessed_at",
    "target",
    "match",
    "format",
    "relationship",
    "disclosure",
    "disclosure_url",
    "summary"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "provider": {"enum": ["youtube", "xhs"]},
    "youtube_video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
    "title": {"type": "string", "minLength": 1},
    "channel_name": {"type": "string", "minLength": 1},
    "channel_url": {"type": "string", "format": "uri"},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "language": {"type": "string", "minLength": 2},
    "published_at": {"type": "string", "format": "date"},
    "accessed_at": {"type": "string", "format": "date"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "variant_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "wheelset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
      },
      "oneOf": [{"required": ["platform_id"]}, {"required": ["variant_id"]}, {"required": ["candidate_id"]}, {"required": ["wheelset_id"]}]
    },
    "match": {"enum": ["exact-platform", "exact-variant", "exact-model-lead", "exact-wheelset"]},
    "format": {"enum": ["hands-on-review", "long-term-review", "model-overview", "build-and-ride", "workshop-guide", "topic-explainer"]},
    "relationship": {
      "enum": [
        "retailer-linked",
        "brand-published",
        "product-supplied",
        "publication-review",
        "owner-review",
        "community-post",
        "unknown"
      ]
    },
    "timestamps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "at_seconds"],
        "properties": {"label": {"type": "string", "minLength": 1}, "at_seconds": {"type": "number", "minimum": 0}}
      }
    },
    "open_graph_player": {
      "description": "YouTube's own published og:video player metadata for this video, checked on verified_at; renders the embed player as og:video on pages featuring the video.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "width", "height", "verified_at"],
      "properties": {
        "type": {"const": "text/html"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "verified_at": {"type": "string", "format": "date"}
      }
    },
    "transcript": {
      "description": "Local review of the public transcript or the exact video's normal player captions on checked_at. Player-caption review retains an evidence digest; no-speech means only music or sound labels. Raw text stays outside Git.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "checked_at"],
      "properties": {
        "status": {"enum": ["creator-captions", "auto-captions", "no-speech", "unavailable"]},
        "method": {"enum": ["youtube-transcript-panel", "youtube-player-captions"]},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "language": {"type": "string", "minLength": 2},
        "checked_at": {"type": "string", "format": "date"},
        "note": {"type": "string", "minLength": 10}
      },
      "allOf": [{
        "if": {"properties": {"method": {"const": "youtube-player-captions"}}},
        "then": {"required": ["evidence_sha256"], "properties": {"status": {"enum": ["creator-captions", "auto-captions", "no-speech"]}}}
      }]
    },
    "takeaways": {
      "description": "Paraphrased, transcript-checked points for the build shown; never a manufacturer specification by themselves.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": {"enum": ["measured", "fit", "build", "ride", "quality", "support", "price", "claim"]},
          "at_seconds": {"type": "number", "minimum": 0},
          "text": {"type": "string", "minLength": 20, "maxLength": 320}
        }
      }
    },
    "disclosure": {"type": "string", "minLength": 20},
    "disclosure_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "summary": {"type": "string", "minLength": 30},
    "xhs_post_id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "source_capture_archive": {"type": "string", "pattern": "^xhs-complete-[^/]+\\.zip$"},
    "source_archive_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"const": "youtube"}}},
      "then": {
        "required": ["youtube_video_id", "channel_url"],
        "properties": {
          "url": {"pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"},
          "channel_url": {"pattern": "^https://(www\\.)?youtube\\.com(?:/|$)"}
        },
        "not": {
          "anyOf": [
            {"required": ["xhs_post_id"]},
            {"required": ["source_capture_archive"]},
            {"required": ["source_archive_sha256"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "xhs"}}},
      "then": {
        "required": ["xhs_post_id", "source_capture_archive", "source_archive_sha256"],
        "properties": {"url": {"pattern": "^https://www\\.xiaohongshu\\.com/explore/[a-f0-9]{24}$"}},
        "not": {"anyOf": [{"required": ["youtube_video_id"]}, {"required": ["timestamps"]}, {"required": ["open_graph_player"]}]}
      }
    },
    {
      "if": {"properties": {"target": {"required": ["platform_id"]}}},
      "then": {"properties": {"match": {"const": "exact-platform"}}}
    },
    {
      "if": {"properties": {"target": {"required": ["variant_id"]}}},
      "then": {"properties": {"match": {"const": "exact-variant"}}}
    },
    {
      "if": {"properties": {"target": {"required": ["candidate_id"]}}},
      "then": {"properties": {"match": {"const": "exact-model-lead"}}}
    },
    {
      "if": {"properties": {"target": {"required": ["wheelset_id"]}}},
      "then": {"properties": {"match": {"const": "exact-wheelset"}, "provider": {"const": "youtube"}}}
    }
  ]
}
