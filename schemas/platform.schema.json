{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/platform.schema.json",
  "title": "Platform",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "brand_id",
    "name",
    "category",
    "frame",
    "tire_clearance",
    "source_ids",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "frame": {
      "type": "object",
      "properties": {
        "measured_weights": {
          "description": "Weights a reviewer measured on one exact frame in a transcript-checked video of this platform; they sit beside, never replace, the claimed weights.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "part",
              "grams",
              "size",
              "basis",
              "video_id",
              "at_seconds"
            ],
            "properties": {
              "part": {
                "enum": [
                  "frame",
                  "fork",
                  "frame-and-fork"
                ]
              },
              "grams": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 5000
              },
              "size": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 5
              },
              "video_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "at_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "tire_clearance": {
      "type": "object",
      "properties": {
        "drivetrain_limits_mm": {
          "type": "object",
          "required": [
            "single",
            "double"
          ],
          "additionalProperties": false,
          "properties": {
            "single": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "double": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          },
          "anyOf": [
            {
              "properties": {
                "single": {
                  "type": "number"
                }
              }
            },
            {
              "properties": {
                "double": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "field_reports": {
          "description": "Transcript-checked reviewer or owner fit observations on one exact build; they qualify, never replace, the recorded maximum.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "video_id",
              "at_seconds",
              "configuration",
              "short",
              "summary"
            ],
            "properties": {
              "video_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "at_seconds": {
                "type": "number",
                "minimum": 0
              },
              "configuration": {
                "type": "string",
                "minLength": 20
              },
              "short": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "summary": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
