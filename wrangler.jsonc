{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "china-bikes",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "account_id": "0317b000520a8e6b237de500c592d67a",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "china-bikes.p0s.eu", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build:cloudflare"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/zh",
      "/zh/*",
      "/models/*",
      "/brands/*",
      "/prices/*",
      "/complete-bikes/*",
      "/framesets/*",
      "/build/*",
      "/methodology/*",
      "/privacy/*",
      "/image-policy/*",
      "/image-sources/*",
      "/electronic-shifting/*",
      "/blog/*",
      "/analytics/*"
    ]
  }
}
