{
  "name": "china-bike-research",
  "version": "2.0.0",
  "private": true,
  "description": "Minimal buyer comparison for bicycles available in China.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-data.mjs",
    "privacy": "node scripts/check-privacy.mjs",
    "coverage:check": "node scripts/coverage.mjs",
    "coverage:accept": "node scripts/coverage.mjs --accept",
    "coverage:report": "node scripts/coverage.mjs --report",
    "data:gaps": "node scripts/data-gaps.mjs",
    "research:check": "node scripts/research-attempts.mjs",
    "research:report": "node scripts/research-attempts.mjs --report",
    "research:queue": "node scripts/research-queue.mjs",
    "research:50-audit": "node scripts/research-50-audit.mjs --campaign all-gaps-50-approaches-2026-08-29",
    "media:optimize": "node scripts/optimize-image.mjs",
    "image:report": "node scripts/image-health-report.mjs",
    "stale:report": "node scripts/stale-report.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run privacy && npm run validate && npm run research:check && npm run coverage:check && npm test && npm run build"
  }
}
